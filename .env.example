# Claude API 키. 없으면 간이 모드(사진 분석 없이 단어 비교)로 동작한다.
ANTHROPIC_API_KEY=

# claude | heuristic. 비워 두면 키가 있을 때 claude를 쓴다.
AI_MODE=
CLAUDE_MODEL=claude-opus-5-5

PORT=3000
# DB와 업로드 사진을 저장할 폴더
DATA_DIR=data

# 검증 구조 문서에서 "추후 결정"으로 남은 값들
WRONG_FEATURE_PENALTY=10
MAX_CLAIMS_PER_DAY=5
WATCHLIST_FAILURE_THRESHOLD=3
